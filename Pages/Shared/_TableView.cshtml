@model MusicStore.Pages.IndexModel

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Cover</th>
            <th>Title</th>
            <th>Artist</th>
            <th>Album</th>
            <th>Genre</th>
            <th>Likes</th>
            <th>Preview</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Songs)
        {
            <tr class="song-row" data-id="@s.Id" style="cursor:pointer;" role="button" aria-expanded="false" title="Click to expand details">
                <td>@s.Id</td>
                <td><img src="@s.CoverImageUrl" width="60" class="rounded" alt="Cover" /></td>
                <td><strong>@s.Title</strong></td>
                <td>@s.Artist</td>
                <td>@(string.IsNullOrEmpty(s.Album) ? "Single" : s.Album)</td>
                <td>@s.Genre</td>
                <td class="likes-count"><span class="badge bg-info">@s.Likes.ToString("N0")</span></td>
                <td><audio controls style="width:220px"><source src="@s.AudioPreviewUrl" type="audio/mpeg"></audio></td>
            </tr>
            <tr class="song-detail d-none" id="detail-@s.Id">
                <td colspan="8">
                    <div class="d-flex gap-3 align-items-start">
                        <div style="flex-shrink:0;">
                            <img src="@s.CoverImageUrl" width="240" class="rounded shadow-sm" alt="Album cover for @s.Title" />
                            <div class="mt-3 text-center">
                                <small class="text-muted">@s.Album</small>
                            </div>
                            <div class="mt-2 text-center">
                                <button class="btn btn-outline-primary btn-sm" onclick="exportSong(@s.Id)">
                                    <i class="bi bi-download"></i> Export Song
                                </button>
                            </div>
                        </div>
                        <div style="flex:1;">
                            <h5 class="mb-2">@s.Title</h5>
                            <p class="mb-1 text-muted"><strong>@s.Artist</strong> • <strong>@s.Genre</strong></p>
                            <p class="mb-3">
                                <span class="badge bg-success">@s.Likes.ToString("N0") likes</span>
                            </p>
                            
                            <!-- Audio player with playback controls -->
                            <div class="mb-3">
                                <label class="d-block mb-2"><small class="text-muted">Play</small></label>
                                <audio controls class="song-player w-100" data-lyrics-url="@s.LyricsUrl" style="max-width:100%">
                                    <source src="@s.AudioPreviewUrl" type="audio/mpeg">
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                            
                            <!-- Review text -->
                            <div class="mb-3">
                                <label class="d-block mb-2"><small class="text-muted"><strong>Review</strong></small></label>
                                <p class="mb-0" style="font-style:italic; color:#666;">@s.Review</p>
                            </div>
                            
                            <!-- Lyrics with sync -->
                            <div class="mt-3">
                                <label class="d-block mb-2"><small class="text-muted"><strong>Lyrics (synced to playback)</strong></small></label>
                                <div class="lyrics-container" style="max-height:200px; overflow:auto; border:1px solid #ddd; padding:12px; background:#fafafa; border-radius:4px;" data-lyrics-url="@s.LyricsUrl">
                                    <em class="text-muted">Loading lyrics...</em>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Proper Pagination -->
<nav aria-label="Table pagination" class="mt-3">
    <ul class="pagination justify-content-center">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="?page=@(Model.CurrentPage - 1)&Language=@Model.Language&Seed=@Model.Seed&LikesPerSong=@Model.LikesPerSong">Previous</a>
            </li>
        }
        <li class="page-item active"><span class="page-link">@Model.CurrentPage</span></li>
        <li class="page-item">
            <a class="page-link" href="?page=@(Model.CurrentPage + 1)&Language=@Model.Language&Seed=@Model.Seed&LikesPerSong=@Model.LikesPerSong">Next</a>
        </li>
    </ul>
</nav>